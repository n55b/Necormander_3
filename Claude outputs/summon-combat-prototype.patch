diff --git a/Assets/Scripts/Entities/Minion/SummonFieldAgent.cs b/Assets/Scripts/Entities/Minion/SummonFieldAgent.cs
new file mode 100644
index 0000000..ba6af42
--- /dev/null
+++ b/Assets/Scripts/Entities/Minion/SummonFieldAgent.cs
@@ -0,0 +1,225 @@
+using System;
+using System.Collections;
+using UnityEngine;
+
+/// <summary>
+/// 장착한 소환수의 필드 표시 + 간단 AI (전투 개편 프로토타입).
+/// 플레이어 주변을 따라다니다 일정 시간마다 가까운 적을 자동 공격한다.
+///
+/// 콜라이더·CharacterHealth·전투 레이어가 전혀 없다. 적의 탐색은 플레이어/레이어 기준이고
+/// 피격은 콜라이더가 있어야 일어나므로, 적은 소환수를 타겟으로 삼거나 맞힐 수 없다.
+/// 수치는 PlayerSkillController 의 Inspector 에서 조절한다.
+/// </summary>
+public class SummonFieldAgent : MonoBehaviour
+{
+    private const float LUNGE_DISTANCE = 0.5f;
+    private const float LUNGE_DURATION = 0.18f;
+
+    private PlayerSkillController _owner;
+    private MainMinionDataSO _data;
+    private Vector2 _sideOffset;
+    private GameObject _visual;
+    private SpriteRenderer _renderer;
+    private VisualSquashStretch _squash;
+    private EntitySoundSet _sounds;
+    private float _attackTimer;
+    private int _linkCount;
+    private bool _moving;
+    private Coroutine _lunge;
+
+    public MainMinionDataSO Data => _data;
+    public bool IsLinking => _linkCount > 0;
+    public bool IsVisualVisible => _visual != null && _visual.activeSelf;
+    public int AutoAttackCount { get; private set; }
+
+    public static SummonFieldAgent Spawn(PlayerSkillController owner, MainMinionDataSO data, int slot)
+    {
+        Vector2 side = slot == 0 ? Vector2.left : Vector2.right;
+        var go = new GameObject($"SummonField_{(data != null ? data.minionName : "?")}");
+        go.transform.position = owner.transform.position + (Vector3)(side * 0.6f);
+        var agent = go.AddComponent<SummonFieldAgent>();
+        agent._owner = owner;
+        agent._data = data;
+        agent._sideOffset = side * 0.6f;
+        // 두 마리가 같은 프레임에 때리지 않게 처음 한 번만 어긋나게 둔다.
+        agent._attackTimer = owner.AutoAttackInterval * (slot == 0 ? 0.5f : 1f);
+        agent.BuildVisual();
+        return agent;
+    }
+
+    private void BuildVisual()
+    {
+        GameObject prefab = _data.basicAnim != null ? _data.basicAnim.visual : null;
+        if (prefab == null && _data.skillAnim != null) prefab = _data.skillAnim.visual;
+        if (prefab == null) return;
+
+        _visual = Instantiate(prefab, transform);
+        _visual.transform.localPosition = Vector3.zero;
+        // 프리팹에 물리가 붙어 있어도 필드 소환수에는 남기지 않는다(피격 판정 없음 보장).
+        foreach (var col in _visual.GetComponentsInChildren<Collider2D>(true)) Destroy(col);
+        foreach (var body in _visual.GetComponentsInChildren<Rigidbody2D>(true)) Destroy(body);
+
+        _renderer = _visual.GetComponentInChildren<SpriteRenderer>();
+        _squash = _visual.GetComponent<VisualSquashStretch>();
+        _sounds = _visual.GetComponentInChildren<EntitySoundSet>();
+
+        var anim = _visual.GetComponentInChildren<Animator>();
+        if (anim == null || anim.runtimeAnimatorController == null) return;
+        anim.gameObject.AddComponent<MinionAnimEventRelay>(); // 클립 이벤트의 "has no receiver" 경고 흡수
+
+        // 대기 클립이 있으면 반복 재생, 없으면 첫 클립의 첫 프레임에 멈춰 둔다.
+        string idle = null, first = null;
+        foreach (var clip in anim.runtimeAnimatorController.animationClips)
+        {
+            if (clip == null) continue;
+            if (first == null) first = clip.name;
+            if (idle == null && clip.name.IndexOf("idle", StringComparison.OrdinalIgnoreCase) >= 0) idle = clip.name;
+        }
+        if (idle != null) anim.Play(idle, 0, 0f);
+        else if (first != null) { anim.Play(first, 0, 0f); anim.speed = 0f; }
+    }
+
+    private void Update()
+    {
+        if (_owner == null) { Destroy(gameObject); return; }
+        if (IsLinking) return;
+        Follow();
+        TickAutoAttack();
+    }
+
+    private void Follow()
+    {
+        Vector2 player = _owner.transform.position;
+        Vector2 me = transform.position;
+        float distance = Vector2.Distance(me, player);
+        // 문 이동처럼 플레이어가 멀리 옮겨지면 걸어가지 않고 옆으로 붙는다. 소환수는 벽 충돌이 없다.
+        if (distance > _owner.FollowTeleportDistance)
+        {
+            transform.position = player + _sideOffset;
+            return;
+        }
+        if (distance <= _owner.FollowDistance) return;
+
+        Vector2 goal = player + _sideOffset;
+        Vector2 next = Vector2.MoveTowards(me, goal, _owner.FollowSpeed * Time.deltaTime);
+        transform.position = next;
+        Face(next.x - me.x);
+    }
+
+    private void Face(float dirX)
+    {
+        if (_renderer != null && Mathf.Abs(dirX) > 0.0001f) _renderer.flipX = dirX > 0f;
+    }
+
+    private void TickAutoAttack()
+    {
+        var player = _owner.GetComponent<PlayerController>();
+        if (player == null || player.Stat == null || player.Stat.IsDead) return;
+        if (player.IsInputBlocked || PlayerController.IsGameplayPaused) return;
+
+        _attackTimer -= Time.deltaTime;
+        if (_attackTimer > 0f) return;
+
+        CharacterHealth target = FindTarget(out Vector2 targetPos);
+        if (target == null) return; // 적이 없으면 준비 상태로 기다리다 사거리에 들면 바로 때린다.
+        _attackTimer = _owner.AutoAttackInterval;
+        AutoAttack(target, targetPos, player);
+    }
+
+    private CharacterHealth FindTarget(out Vector2 position)
+    {
+        position = default;
+        CharacterHealth best = null;
+        float bestSqr = _owner.AutoAttackRange * _owner.AutoAttackRange;
+        Vector2 me = transform.position;
+        foreach (var enemy in CharacterStatus.ActiveEnemies)
+        {
+            if (enemy == null) continue;
+            var health = enemy.GetComponent<CharacterHealth>() ?? enemy.GetComponentInParent<CharacterHealth>();
+            if (health == null || health.IsDead || health.Invincible) continue;
+            float sqr = ((Vector2)enemy.transform.position - me).sqrMagnitude;
+            if (sqr > bestSqr) continue;
+            bestSqr = sqr;
+            best = health;
+            position = enemy.transform.position;
+        }
+        return best;
+    }
+
+    private void AutoAttack(CharacterHealth target, Vector2 targetPos, PlayerController player)
+    {
+        // 액티브 스킬과 같은 갈래(Skill) · 같은 공격자 규칙(시전 오브젝트)이다. 경직/넉백/슈퍼아머 삭감은 없다.
+        float damage = player.Stat.ATK * _owner.AutoAttackDamageMultiplier;
+        var element = _data.finisher != null ? _data.finisher.element : DamageType.Physical;
+        var info = new DamageInfo(damage, element, gameObject, 1f,
+            !string.IsNullOrEmpty(_data.minionName) ? $"{_data.minionName} 자동 공격" : "소환수 자동 공격",
+            category: DamageCategory.Skill);
+        target.GetDamage(info);
+        AutoAttackCount++;
+
+        Face(targetPos.x - transform.position.x);
+        _squash?.PlayAttack();
+        _sounds?.Play(SoundTrigger.OnBasicDamageDealt);
+        if (_lunge != null) StopCoroutine(_lunge);
+        _lunge = StartCoroutine(LungeRoutine(targetPos));
+    }
+
+    private IEnumerator LungeRoutine(Vector2 targetPos)
+    {
+        if (_visual == null) yield break;
+        Vector2 dir = (targetPos - (Vector2)transform.position).normalized;
+        float t = 0f;
+        while (t < LUNGE_DURATION && _visual != null)
+        {
+            t += Time.deltaTime;
+            _visual.transform.localPosition = dir * (LUNGE_DISTANCE * Mathf.Sin(Mathf.Clamp01(t / LUNGE_DURATION) * Mathf.PI));
+            yield return null;
+        }
+        if (_visual != null) _visual.transform.localPosition = Vector3.zero;
+        _lunge = null;
+    }
+
+    /// <summary>
+    /// 플레이어 행동 연계: 플레이어 위치로 빠르게 이동 → 행동 수행 → 행동이 끝나고 복귀 지연 뒤 일반 AI.
+    /// 행동의 외형은 MinionSkillCaster 가 그리므로, 그동안 필드 외형은 숨겨 두 마리로 보이지 않게 한다.
+    /// </summary>
+    /// <param name="perform">실제 행동. 시전 오브젝트를 돌려주며, 실패하면 null.</param>
+    public void PlayLink(Func<MinionSkillCaster> perform)
+    {
+        StartCoroutine(LinkRoutine(perform));
+    }
+
+    private IEnumerator LinkRoutine(Func<MinionSkillCaster> perform)
+    {
+        _linkCount++;
+        if (_lunge != null) { StopCoroutine(_lunge); _lunge = null; }
+        if (_visual != null) _visual.transform.localPosition = Vector3.zero;
+
+        if (_moving) yield return new WaitWhile(() => _moving); // 앞선 연계가 이동 중이면 그 도착에 맞춰 함께 나간다.
+        else if (IsVisualVisible)
+        {
+            _moving = true;
+            Vector2 from = transform.position;
+            float duration = _owner.LinkMoveDuration;
+            for (float t = 0f; t < duration; t += Time.deltaTime)
+            {
+                transform.position = Vector2.Lerp(from, _owner.transform.position, t / duration);
+                yield return null;
+            }
+            transform.position = _owner.transform.position;
+            _moving = false;
+        }
+
+        if (_visual != null) _visual.SetActive(false);
+        MinionSkillCaster caster = perform != null ? perform() : null;
+        if (caster != null) yield return new WaitUntil(() => caster == null);
+        yield return new WaitForSeconds(_owner.LinkReturnDelay);
+
+        _linkCount--;
+        if (_linkCount == 0 && _visual != null)
+        {
+            _visual.SetActive(true);
+            transform.position = (Vector2)_owner.transform.position + _sideOffset;
+        }
+    }
+}
