  - m_Id: 616334008320
    m_Localized: "\uAC15\uD0C0/\uAE30\uC808/\uACA9\uD30C \uC0C1\uD0DC\uB97C \uBD80\uC5EC\uD558\uAE30
      \uC704\uD55C \uC2A4\uD0DD\uC785\uB2C8\uB2E4. \uC2A4\uD0DD\uC740 20\uCD08\uB3D9\uC548
      \uC720\uC9C0\uB418\uBA70, \uCD5C\uB300 \uC2A4\uD0DD\uC740 3\uC2A4\uD0DD\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4410816994385920
    m_Localized: "\uAE30\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 4410933583454208
    m_Localized: "\uB370\uBBF8\uC9C0\uB97C \uBD80\uC5EC\uD558\uACE0 \uAE30\uC808
      \uC2DC\uD0A4\uBA70, \uC77C\uC815\uC2DC\uAC04\uB3D9\uC548 \uD589\uB3D9 \uBD88\uB2A5\uC73C\uB85C
      \uB9CC\uB4ED\uB2C8\uB2E4.\n\uC2A4\uD0DD\uC5D0 \uB530\uB77C \uB370\uBBF8\uC9C0\uC640
      \uAE30\uC808 \uC2DC\uAC04\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n100 / 150
      / 200% \uB370\uBBF8\uC9C0 \uBD80\uC5EC\r\n0.5 / 1 / 1.5\uCD08 \uAE30\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 4411268486045696
    m_Localized: "\uACA9\uD30C"
    m_Metadata:
      m_Items: []
  - m_Id: 4411496823955456
    m_Localized: "\uC77C\uC815 \uC2DC\uAC04 \uB3D9\uC548 \uAE30\uBCF8 \uACF5\uACA9
      \uD53C\uD574\uB97C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\n\uC2A4\uD0DD\uC5D0
      \uB530\uB77C \uC801\uC6A9 \uC2DC\uAC04\uACFC \uB370\uBBF8\uC9C0\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\uC801\uC6A9
      \uC2DC\uAC04\r\n12 / 18 / 24\uCD08\r\n\uAE30\uBCF8 \uACF5\uACA9 \uD53C\uD574\r\n12
      / 18 / 24% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 4412421667987456
    m_Localized: "\uAC15\uD0C0"
    m_Metadata:
      m_Items: []
  - m_Id: 4412423886774272
    m_Localized: "\uCDE8\uC57D \uC2A4\uD0DD\uC5D0 \uBE44\uB840\uD558\uC5EC \uAC15\uD55C
