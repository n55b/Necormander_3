  - m_Id: 538340925440
    m_Localized: "\uCDE8\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 616334008320
    m_Localized: "\uAC15\uD0C0/\uAE30\uC808/\uACA9\uD30C \uC0C1\uD0DC\uB97C \uBD80\uC5EC\uD558\uAE30
      \uC704\uD55C \uC2A4\uD0DD\uC785\uB2C8\uB2E4. \uC2A4\uD0DD\uC740 20\uCD08\uB3D9\uC548
      \uC720\uC9C0\uB418\uBA70, \uCD5C\uB300 \uC2A4\uD0DD\uC740 3\uC2A4\uD0DD\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4410816994385920
    m_Localized: "\uAE30\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 4410933583454208
    m_Localized: "\uB370\uBBF8\uC9C0\uB97C \uBD80\uC5EC\uD558\uACE0 \uAE30\uC808
      \uC2DC\uD0A4\uBA70, \uC77C\uC815\uC2DC\uAC04\uB3D9\uC548 \uD589\uB3D9 \uBD88\uB2A5\uC73C\uB85C
      \uB9CC\uB4ED\uB2C8\uB2E4.\n\uC2A4\uD0DD\uC5D0 \uB530\uB77C \uB370\uBBF8\uC9C0\uC640
      \uAE30\uC808 \uC2DC\uAC04\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n100 / 150
      / 200% \uB370\uBBF8\uC9C0 \uBD80\uC5EC\r\n0.5 / 1 / 1.5\uCD08 \uAE30\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 40506764393824256
    m_Localized: "\uC804\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 40506764452544512
    m_Localized: "\uAE30\uBCF8 \uADFC\uC811 \uC18C\uD658\uC218. \uBCF4\uC0C1\uBC29\uC5D0\uC11C
      \uAE30\uC0AC \uB610\uB294 \uBB34\uC0AC\uB85C \uC9C4\uD654\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 40506764456738816
    m_Localized: "\uAE30\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 40506764456738817
    m_Localized: "\uC804\uC0AC\uC758 1\uCC28 \uD2B8\uB9AC. \uBB35\uC9C1\uD55C \uC77C\uACA9\uACFC
      \uAC15\uD55C \uC2A4\uD0AC\uC744 \uC4F0\uBA70, \uC6A9\uC0AC\uB85C \uC9C4\uD654\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 40506764456738818
    m_Localized: "\uC6A9\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 40506764456738819
    m_Localized: "\uACF5\uACA9 \uC18D\uB3C4\uB294 \uBE60\uB974\uC9C0 \uC54A\uC9C0\uB9CC
      \uC2A4\uD0AC\uC774 \uB9E4\uC6B0 \uAC15\uB825\uD55C \uC18C\uD658\uC218."
    m_Metadata:
      m_Items: []
  - m_Id: 40506764456738820
    m_Localized: "\uBB34\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 40506764456738821
    m_Localized: "\uC804\uC0AC\uC758 2\uCC28 \uD2B8\uB9AC. \uBE60\uB978 \uC5F0\uD0C0\uB85C
      \uBAB0\uC544\uCE58\uBA70, \uC7A5\uC218\uB85C \uC9C4\uD654\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 40506764456738822
    m_Localized: "\uC7A5\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 40506764456738823
    m_Localized: "\uD0C0\uC218\uAC00 \uB9CE\uACE0 \uACF5\uACA9 \uC18D\uB3C4\uAC00
      \uBE60\uB978 \uC18C\uD658\uC218."
    m_Metadata:
      m_Items: []
