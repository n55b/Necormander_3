      m_Items: []
  - m_Id: 48123772637259
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB098 \uC18C\uBAA8\uB7C9 1\uB2F9 \uD22C\uCC99
      \uD6A8\uACFC\uAC00 2% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122150543360
    m_Localized: "\uB3C5 \uC9C0\uC18D \uC2DC\uAC04\uC774 +5\uCD08 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931968
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 \uC2DC 1\uAC1C\uC758 \uCD94\uAC00 \uB3C5
      \uC2A4\uD0DD\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931969
    m_Localized: "\uB3C5 \uD2F1 \uAC04\uACA9\uC774 3\uCD08(0.6\uBC30)\uB85C \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931970
    m_Localized: "\uC2A4\uD0DD\uB2F9 \uB454\uD654 \uD6A8\uACFC\uAC00 5% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931971
    m_Localized: "\uBE59\uACB0 \uC2DC 25\uAC1C\uC758 \uD55C\uAE30 \uC2A4\uD0DD\uC744
      \uB3CC\uB824\uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931972
    m_Localized: "\uBE59\uACB0 \uC2DC \uCD5C\uB300 \uCCB4\uB825 \uBE44\uB840 \uACE0\uC815
      \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931973
    m_Localized: "\uD53C\uC758 \uD3ED\uBC1C \uD53C\uD574 \uBC30\uC728\uC774 0.5\uB85C
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931974
    m_Localized: "\uD53C\uC758 \uD3ED\uBC1C \uBC18\uACBD\uC774 1.5\uBC30 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931975
    m_Localized: "\uC2A4\uD0DD\uB2F9 \uB454\uD654 \uD6A8\uACFC\uAC00 5% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931976
    m_Localized: "\uCD5C\uB300 \uB178\uD654 \uC2A4\uD0DD\uC774 120\uC73C\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931977
    m_Localized: "\uB178\uD654\uB41C \uC801\uC774 12%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C
      \uC785\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931978
    m_Localized: "\uBD80\uC2DD \uD53C\uD574 \uC99D\uD3ED\uB7C9\uC774 25%\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931979
    m_Localized: "\uBD80\uC2DD \uD53C\uD574 \uC99D\uD3ED\uB7C9\uC774 40%\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931980
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9\uACFC \uD22C\uCC99 \uC2DC 1\uAC1C\uC758
      \uCC98\uD615 \uC2A4\uD0DD\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931981
    m_Localized: "\uCCB4\uB825\uC774 50% \uBBF8\uB9CC\uC778 \uC801\uC5D0\uAC8C \uC804\uC0AC
      \uD22C\uCC99 \uD53C\uD574\uAC00 20% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931982
    m_Localized: "\uC804\uC0AC \uD22C\uCC99 \uCCB4\uB825 \uC18C\uBAA8\uB7C9\uC774
      30% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931983
    m_Localized: "\uC801\uC758 \uC783\uC740 \uCCB4\uB825\uC5D0 \uBE44\uB840\uD558\uC5EC
      \uD22C\uCC99 \uD53C\uD574\uAC00 \uCD5C\uB300 50%\uAE4C\uC9C0 \uC99D\uD3ED\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931984
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9\uC774 5\uBC88 \uBE57\uB098\uAC08 \uB54C\uB9C8\uB2E4
      \uAD00\uD1B5\uD558\uB294 \uD654\uC0B4\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931985
    m_Localized: "\uBC29\uD328\uBCD1 \uD22C\uCC99 \uC2DC \uBCF4\uD638\uB9C9\uC758
      20%\uB9CC\uD07C \uAD11\uC5ED \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931986
    m_Localized: "\uBCF4\uD638\uB9C9 \uB9CC\uB8CC \uC2DC \uC8FC\uBCC0 \uC801\uB4E4\uC5D0\uAC8C
      \uACE0\uC815 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931987
    m_Localized: "\uCD08\uACFC \uCE58\uC720\uB7C9\uC758 15%\uB97C \uBCF4\uD638\uB9C9\uC73C\uB85C
      \uC804\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931988
    m_Localized: "\uBCF4\uD638\uB9C9\uC774 \uC788\uB294 \uB3D9\uC548 \uBAA8\uB4E0
      \uC2A4\uD0EF\uC774 15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931989
    m_Localized: "\uB3CC\uC9C4 \uAC70\uB9AC +30%, \uB3CC\uC9C4 \uC18D\uB3C4 +20%."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931990
    m_Localized: "\uB3CC\uC9C4\uC774 \uCDA9\uB3CC\uD55C \uC801\uC5D0\uAC8C 150%\uC758
      \uBB3C\uB9AC \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931991
    m_Localized: "\uB3CC\uC9C4\uC5D0 \uB2FF\uC740 \uC544\uAD70\uC774 \uC774\uB3D9/\uD68C\uD53C
      \uC18D\uB3C4 +15%\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931992
    m_Localized: "\uB3CC\uC9C4 \uC911 \uD50C\uB808\uC774\uC5B4\uAC00 \uBB34\uC801
      \uC0C1\uD0DC\uAC00 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931993
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB098 \uC7AC\uC0DD +1 (\uBE44\uC804\uD22C \uBC0F
      \uAE30\uBCF8)."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931994
    m_Localized: "\uCD5C\uB300 \uC2A4\uD0DC\uBBF8\uB098 +20."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931995
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB098\uAC00 0\uC77C \uB54C \uC7AC\uC0DD\uB7C9\uC774
      \uCD5C\uB300 2\uBC30\uAE4C\uC9C0 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931996
    m_Localized: "\uC9C1\uC0AC \uD22C\uCC99 \uD6A8\uC728 +50%."
    m_Metadata:
      m_Items: []
  - m_Id: 51122158931997
    m_Localized: "\uC9C1\uC0AC \uD22C\uCC99 \uD6A8\uC728 +75%."
    m_Metadata:
      m_Items: []
  - m_Id: 71717584080896
    m_Localized: "\uD0C4\uB3C4\uD559"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441024
    m_Localized: "\uAC70\uB9AC\uC5D0 \uBE44\uB840\uD558\uC5EC 1\uCE78\uB9C8\uB2E4
      \uD22C\uCC99 \uD6A8\uC728 10% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441025
    m_Localized: "\uD6A8\uC728\uC801\uC778 \uACE1\uC120"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441026
    m_Localized: "\uD3EC\uBB3C\uC120 \uB358\uC9C0\uAE30\uC758 \uD22C\uCC99 \uC18D\uB3C4\uAC00
      \uBE68\uB77C\uC9D1\uB2C8\uB2E4. (20% \uB354 \uBE68\uB9AC \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441027
    m_Localized: "\uC77C\uB2E8 \uB358\uC9C0\uACE0 \uBCF4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441028
    m_Localized: "\uC774\uBC88 \uBC29\uC5D0\uC11C \uD3EC\uBB3C\uC120 \uB358\uC9C8
      \uB54C \uB9C8\uB2E4 8\uCD08\uB3D9\uC548 \uD22C\uCC99 \uC18D\uB3C4\uAC00 8%
      \uBE68\uB77C\uC9C0\uBA70 \uD574\uB2F9 \uD6A8\uACFC\uB294 5\uBC88\uAE4C\uC9C0
      \uC911\uCCA9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441029
    m_Localized: "\uB2E8\uC548\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441030
    m_Localized: "5\uCE78\uC744 \uAE30\uC900\uC73C\uB85C \uC5ED\uC21C. \uC989 \uC790\uAE30
      \uBC1C\uBC11\uC5D0 \uB358\uC9C0\uBA74 \uD22C\uCC99 \uD6A8\uC728\uC774 \uCD5C\uB300(50%)
      \uC99D\uAC00\uD558\uBA70, \uBA40\uC5B4\uC9C8\uC218\uB85D \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441031
    m_Localized: "\uAC01\uB3C4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441032
    m_Localized: "\uD3EC\uBB3C\uC120 \uB358\uC9C0\uAE30 \uC2DC \uD22C\uCC99 \uD6A8\uC728\uC774
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441033
    m_Localized: "\uC2DC\uC988 \uBAA8\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441034
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uAC00 \uD574\uB2F9 \uC704\uCE58\uC5D0
      \uACE0\uC815\uB418\uBA70, \uCE74\uBA54\uB77C \uC704\uCE58\uAC00 \uB113\uAC8C
      \uACE0\uC815\uB429\uB2C8\uB2E4.\n\uBCF4\uC720\uD55C \uC18C\uD658\uC218\uC758
      \uC218 \uB9CC\uD07C \uD0C4\uC57D\uC73C\uB85C \uBCC0\uACBD\uB418\uC5B4 \uACE0\uAC01\uB3C4
      \uD3EC\uACA9\uC744 \uC2E4\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441035
    m_Localized: "\uC774\uBC88 \uBC29\uC5D0\uC11C \uD3EC\uBB3C\uC120 \uB358\uC9C8
      \uB54C \uB9C8\uB2E4 8\uCD08\uB3D9\uC548 \uD22C\uCC99 \uC18D\uB3C4\uAC00 8%
      \uBE68\uB77C\uC9C0\uBA70 \uD574\uB2F9 \uD6A8\uACFC\uB294 5\uBC88\uAE4C\uC9C0
      \uC911\uCCA9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441036
    m_Localized: "\uAC70\uB9AC\uC5D0 \uBE44\uB840\uD558\uC5EC 1\uCE78\uB9C8\uB2E4
      \uD22C\uCC99 \uD6A8\uC728 10% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441037
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uAC00 \uD574\uB2F9 \uC704\uCE58\uC5D0
      \uACE0\uC815\uB418\uBA70, \uCE74\uBA54\uB77C \uC704\uCE58\uAC00 \uB113\uAC8C
      \uACE0\uC815\uB429\uB2C8\uB2E4.\n\uBCF4\uC720\uD55C \uC18C\uD658\uC218\uC758
      \uC218 \uB9CC\uD07C \uD0C4\uC57D\uC73C\uB85C \uBCC0\uACBD\uB418\uC5B4 \uACE0\uAC01\uB3C4
      \uD3EC\uACA9\uC744 \uC2E4\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 71717613441038
    m_Localized: "5\uCE78\uC744 \uAE30\uC900\uC73C\uB85C \uC5ED\uC21C. \uC989 \uC790\uAE30
      \uBC1C\uBC11\uC5D0 \uB358\uC9C0\uBA74 \uD22C\uCC99 \uD6A8\uC728\uC774 \uCD5C\uB300(50%)
      \uC99D\uAC00\uD558\uBA70, \uBA40\uC5B4\uC9C8\uC218\uB85D \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 98372570550272
    m_Localized: "\uC794\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938880
    m_Localized: "\uBC14\uB85C \uC9C1\uC804\uC758 \uC18C\uD658\uC218 \uC870\uD569(\uD0C0\uC785,
      \uAC1C\uC218, \uC21C\uC11C\uAC00 \uB3D9\uC77C)\uC744 \uB611\uAC19\uC774 \uC5F0\uC18D\uD574\uC11C
      \uB358\uC9C8 \uC2DC, \uD574\uB2F9 \uC870\uD569\uC758 \uD22C\uCC99 \uD6A8\uC728
      150% \uC99D\uD3ED"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938881
    m_Localized: "\uB2E4 \uB0B4\uAEBC\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938882
    m_Localized: "\uC18C\uD658\uC218 1\uB9C8\uB9AC\uB97C \uC9D1\uC744 \uB54C \uB9C8\uB2E4
      \uC9D1\uC744 \uC218 \uC788\uB294 \uC18C\uD658\uC218 \uBC94\uC704 \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938883
    m_Localized: "\uADC0\uC218\uC758 \uD798"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938884
    m_Localized: "\uC9D1\uC744 \uC218 \uC788\uB294 \uC18C\uD658\uC218 \uBC94\uC704
      0.5\uCE78 \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938885
    m_Localized: "\uACE8\uB808\uB9C8\uC774\uC9D5"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938886
    m_Localized: "\uC870\uD569 \uD22C\uCC99 \uC2DC, \uC55E\uC758 5\uBA85\uC758 \uC18C\uD658\uC218\uAC00
      \uC77C\uC815 \uC2DC\uAC04\uB3D9\uC548 \uACE8\uB818\uC73C\uB85C \uD569\uCCB4\uD569\uB2C8\uB2E4.
      \uB2A5\uB825\uCE58\uB294 5\uB9C8\uB9AC\uB97C \uD569\uD55C \uAC83\uACFC \uAC19\uACE0
      \uB9E4\uC6B0 \uAC70\uB300\uD574\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938887
    m_Localized: "\uC778\uD574\uC804\uC220"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938888
    m_Localized: "3\uBA85 \uC774\uC0C1 \uD22C\uCC99 \uC2DC 1\uBA85\uB2F9 \uD22C\uCC99
      \uD6A8\uC728 7% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938889
    m_Localized: "\uAD70\uC911\uC2EC\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938890
    m_Localized: "\uC18C\uD658\uC218 \uC9D1\uAE30 \uBC94\uC704 \uB0B4 \uC18C\uD658\uC218\uAC00
      \uB9CE\uC744 \uACBD\uC6B0 1\uBA85\uB2F9 \uD50C\uB808\uC774\uC5B4 \uC774\uB3D9\uC18D\uB3C4
      0.1\uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938891
    m_Localized: "\uC2E0\uC18D\uD55C \uC7AC\uBC30\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938892
    m_Localized: "3\uBA85 \uC774\uC0C1 \uD22C\uCC99 \uC2DC \uC0AC\uC6A9\uB41C \uC18C\uD658\uC218\uB4E4\uC758
      \uC774\uB3D9 \uC18D\uB3C4\uAC00 5\uCD08\uAC04 50% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938893
    m_Localized: "\uC30D\uB465\uC774 \uC5F0\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 98372578938894
    m_Localized: "\uC870\uD569 \uD22C\uCC99 \uC2DC \uC55E \uD050\uC758 2\uBA85\uC758
      \uC18C\uD658\uC218\uAC00 10\uCD08\uB3D9\uC548 \uD569\uCCB4\uD569\uB2C8\uB2E4.
      \uD569\uCCB4\uD55C \uC18C\uD658\uC218\uC758 \uB2A5\uB825\uCE58\uB294 2\uBA85\uC758
      \uC18C\uD658\uC218\uB97C \uD569\uD55C \uAC83\uACFC \uAC19\uC2B5\uB2C8\uB2E4.
