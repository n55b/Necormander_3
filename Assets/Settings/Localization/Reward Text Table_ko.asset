      12%\uB97C \uD53C\uD574\uB85C \uC785\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531825
    m_Localized: "\uD22C\uCC99 \uCC29\uD0C4 \uC2DC\uAC04\uC744 33% \uB2E8\uCD95\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531826
    m_Localized: "\uCC3D\uBCD1\uC758 \uAE30\uBCF8 \uACF5\uACA9 \uD53C\uD574\uAC00
