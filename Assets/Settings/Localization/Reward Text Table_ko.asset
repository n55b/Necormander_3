      m_Items: []
  - m_Id: 41536819531818
    m_Localized: "\uBC29\uD328\uBCD1\uC758 \uBAA8\uB4E0 \uC2A4\uD0EF\uC774 10% \uC99D\uAC00\uD569\uB2C8\uB2E4.\\n\uBC29\uC5D0
