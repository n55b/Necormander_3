    m_Metadata:
      m_Items: []
  - m_Id: 48123772637236
    m_Localized: "\uB3CC\uC9C4 \uAC70\uB9AC\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637237
    m_Localized: "\uC801\uC744 \uCC98\uD615\uD560 \uB54C \uCD08\uACFC\uB41C \uD22C\uCC99
