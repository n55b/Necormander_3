    m_Metadata:
      m_Items: []
  - m_Id: 6213641146368
    m_Localized: "\uD540\uBCFC \uD22C\uCC99 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 6213641146369
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uD540\uBCFC"
    m_Metadata:
      m_Items: []
  - m_Id: 6213641146370
    m_Localized: "\uBC18\uBCF5 \uD22C\uCC99 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 6213641146371
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uBC18\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 6213649534976
    m_Localized: "\uD0C0\uC774\uBC0D \uCC28\uC9C0 \uD22C\uCC99 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 6213649534977
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uD0C0\uC774\uBC0D \uCC28\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 6213653729280
    m_Localized: "\uBBF8\uB2C8\uC5B8 \uC2A4\uD0EF \uBCF4\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 6213653729281
    m_Localized: "\uBAA8\uB4E0 \uBBF8\uB2C8\uC5B8\uC758 \uB2A5\uB825\uCE58\uB97C
      \uAC15\uD654\uD558\uB294 \uBCF4\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6213653729282
    m_Localized: "\uD22C\uCC99 \uD6A8\uACFC \uBCF4\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 6213653729283
    m_Localized: "\uBAA8\uB4E0 \uD22C\uCC99 \uD6A8\uACFC\uB97C \uAC15\uD654\uD558\uB294
      \uBCF4\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6213708255232
    m_Localized: "\uAE30\uBCF8 \uAD81\uC218 \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 6213733421056
    m_Localized: "\uAE30\uBCF8 \uC0AC\uC81C \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 6213746003968
    m_Localized: "\uAE30\uBCF8 \uBC29\uD328\uBCD1 \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 6213758586880
    m_Localized: "\uAE30\uBCF8 \uCC3D\uBCD1 \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 6213779558400
    m_Localized: "\uAE30\uBCF8 \uC804\uC0AC \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 41536806948864
    m_Localized: "\uD544\uB4DC \uC704\uC758 \uCD1D \uB178\uD654 \uC2A4\uD0DD 100\uB2F9
      \uC544\uAD70\uC758 \uACF5\uACA9 \uC18D\uB3C4\uAC00 10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531776
    m_Localized: "\uB178\uD654 \uC2A4\uD0DD\uC774 50 \uC774\uC0C1\uC778 \uC801\uC758
      \uACF5\uACA9 \uBE57\uB098\uAC10 \uD655\uB960\uC774 25% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531777
    m_Localized: "\uAC00\uC7A5 \uB178\uD654 \uC2A4\uD0DD\uC774 \uB192\uC740 \uC801
      \uC8FC\uBCC0\uC5D0 20% \uB454\uD654 \uBC0F \uB178\uD654 \uC7A5\uD310\uC744
      \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531778
    m_Localized: "\uCD5C\uB300 \uB178\uD654 \uC2A4\uD0DD\uC774 100\uC73C\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uCD5C\uB300 \uC2A4\uD0DD \uB3C4\uB2EC \uC2DC \uB300\uC0C1\uC744 \uC989\uC0AC\uC2DC\uD0B5\uB2C8\uB2E4
      (\uBCF4\uC2A4 \uC81C\uC678)."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531779
    m_Localized: "\uD22C\uCC99 \uBC94\uC704 \uC911\uC2EC\uC5D0 \uC788\uB294 \uC801\uC5D0\uAC8C
      20%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531780
    m_Localized: "\uBC94\uC704 \uB0B4\uC5D0 \uC801\uC911\uD55C \uC801 \uD558\uB098\uB2F9
      \uD22C\uCC99 \uD53C\uD574\uAC00 5% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531781
    m_Localized: "\uACF5\uACA9 \uBE57\uB098\uAC10 \uC2DC \uCCB4\uB825\uC774 50% \uBBF8\uB9CC\uC774\uBA74
      \uACF5\uACA9\uB825\uC774 15% \uC99D\uAC00\uD558\uACE0, 50% \uC774\uC0C1\uC774\uBA74
      \uACF5\uACA9 \uC18D\uB3C4\uAC00 15% \uC99D\uAC00\uD569\uB2C8\uB2E4. (\uBCF4\uC774\uC9C0
      \uC54A\uB294 \uBE57\uB098\uAC10 \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531782
    m_Localized: "\uAD81\uC218\uC758 \uD22C\uCC99 \uBC94\uC704 \uBC18\uACBD\uC774
      20% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531783
    m_Localized: "\uAD81\uC218\uC758 \uAD11\uC5ED \uD22C\uCC99 \uD53C\uD574\uAC00
      15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531784
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 \uC18D\uB3C4\uAC00 25% \uAC10\uC18C\uD558\uC9C0\uB9CC
      \uAE30\uBCF8 \uACF5\uACA9 \uD53C\uD574\uAC00 25% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531785
    m_Localized: "\uD2B8\uB9AC\uAC70\uB85C \uC791\uC6A9\uD569\uB2C8\uB2E4: \uAE30\uBCF8
      \uACF5\uACA9 \uBE57\uB098\uAC10 \uC2DC \uB2E4\uC74C \uBC84\uD504\uAC00 \uC7A5\uC804\uB429\uB2C8\uB2E4.
      (\uC790\uC5F0\uC758 \uD22C\uC601 \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531786
    m_Localized: "\uBE44\uD589 \uAC70\uB9AC\uC5D0 \uBE44\uB840\uD558\uC5EC \uD22C\uCC99
      \uD53C\uD574\uAC00 1%\uC5D0\uC11C 33%\uAE4C\uC9C0 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531787
    m_Localized: "\uD76C\uC0DD\uC790\uAC00 20%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C
      \uBC1B\uB294 \uC57D\uD654 \uB514\uBC84\uD504\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531788
    m_Localized: "\uD3ED\uBC1C \uC2DC \uD53C\uC758 \uD3ED\uBC1C \uC2A4\uD0DD\uC758
      \uB450 \uBC30\uB9CC\uD07C \uC544\uAD70\uC5D0\uAC8C \uBCF4\uD638\uB9C9\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531789
    m_Localized: "\uD3ED\uBC1C \uD53C\uD574\uC758 1/4\uC744 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C
      \uD53C\uC758 \uD3ED\uBC1C \uC2A4\uD0DD\uC73C\uB85C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531790
    m_Localized: "\uD3ED\uBC1C \uBC18\uACBD \uB0B4\uC758 \uC544\uAD70\uC744 \uD53C\uC758
      \uD3ED\uBC1C \uC2A4\uD0DD \uC218\uB9CC\uD07C \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531791
    m_Localized: "\uD53C\uC758 \uD3ED\uBC1C \uD53C\uD574\uAC00 10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531792
    m_Localized: "\uD3ED\uBC1C \uD6C4 5\uCD08\uAC04 \uC720\uC9C0\uB418\uB294 \uB3C5
      \uC7A5\uD310\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531793
    m_Localized: "\uD3ED\uBC1C \uC804 1.5\uBC30 \uBC18\uACBD \uB0B4\uC758 \uC801\uB4E4\uC744
      \uB04C\uC5B4\uB2F9\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531794
    m_Localized: "\uBE59\uACB0 \uC2DC \uBC18\uACBD \uB0B4\uC5D0 50\uC758 \uD55C\uAE30
      \uC2A4\uD0DD\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4 (\uBC29\uB2F9 1\uD68C)."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531795
    m_Localized: "\uBE59\uACB0 \uC2DC \uD55C\uAE30 \uC2A4\uD0DD\uC774 10\uC5D0\uC11C
      \uC2DC\uC791\uD569\uB2C8\uB2E4. \uBE59\uACB0 \uC911\uC5D0\uB294 \uC2A4\uD0DD\uC774
      \uC313\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531796
    m_Localized: "\uC8FC\uBCC0 \uC801\uB4E4\uC5D0\uAC8C 1\uC758 \uD55C\uAE30 \uC2A4\uD0DD\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531797
    m_Localized: "\uD55C\uAE30\uAC00 \uBB3B\uC740 \uC801\uC5D0\uAC8C 10%\uC758 \uCD94\uAC00
      \uB454\uD654\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531798
    m_Localized: "\uD55C\uAE30\uAC00 \uBB3B\uC740 \uC801\uC5D0\uAC8C 5%\uC758 \uCD94\uAC00
      \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531799
    m_Localized: "\uD22C\uCC99 \uC2DC \uBE59\uACB0\uC744 \uD574\uC81C\uD558\uACE0
      50%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531800
    m_Localized: "\uCD5C\uB300 \uD55C\uAE30 \uC2A4\uD0DD\uACFC \uBE59\uACB0 \uC784\uACC4\uAC12\uC774
      10 \uC99D\uAC00\uD569\uB2C8\uB2E4 (\uCD1D 30)."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531801
    m_Localized: "\uBD80\uC2DD \uC2DC\uB108\uC9C0\uC758 \uD53C\uD574 \uC99D\uD3ED\uB7C9\uC774
