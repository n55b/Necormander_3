    m_Metadata:
      m_Items: []
  - m_Id: 41536819531812
    m_Localized: "\uB3C5 \uBC1C\uC790\uAD6D \uC7A5\uD310\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4.
      \uC544\uAD70\uC758 \uC774\uB3D9 \uC18D\uB3C4\uAC00 15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531813
    m_Localized: "3\uCD08\uB9C8\uB2E4 \uC8FC\uBCC0 \uBC18\uACBD\uC5D0 \uB3C5 \uC2A4\uD0DD\uC744
      \uD37C\uB728\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531814
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 \uC2DC \uB3C5 \uD53C\uD574 \uD2F1 \uAC04\uACA9\uC774
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
