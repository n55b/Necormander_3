    m_Metadata:
      m_Items: []
  - m_Id: 48123772637243
    m_Localized: "\uC804\uC0AC\uC758 \uBAA8\uB4E0 \uAE30\uBCF8 \uC2A4\uD0EF\uC774
      15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637244
    m_Localized: "\uCD5C\uB300 \uCC28\uC9C0 \uC2DC\uAC04 \uC81C\uD55C\uC774 5\uCD08\uB85C
