    m_Metadata:
      m_Items: []
  - m_Id: 41536819531804
    m_Localized: "\uBD80\uC2DD\uB41C \uC801\uC758 \uACF5\uACA9\uB825\uC774 10% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531805
    m_Localized: "\uB300\uC0C1\uC744 \uCC98\uD615\uD560 \uB54C 1\uCD08 \uB3D9\uC548
