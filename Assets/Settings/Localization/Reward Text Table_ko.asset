    m_Metadata:
      m_Items: []
  - m_Id: 41536819531829
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9\uC5D0 3%\uC758 \uC0DD\uBA85\uB825 \uD761\uC218\uB97C
