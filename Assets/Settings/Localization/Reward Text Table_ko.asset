    m_Metadata:
      m_Items: []
  - m_Id: 41536819531806
    m_Localized: "\uCC98\uD615 \uC784\uACC4\uAC12\uC774 10% \uC644\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531807
    m_Localized: "\uB3C5 \uD53C\uD574 \uD2F1\uB9C8\uB2E4 \uD3EC\uC158\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531808
    m_Localized: "\uB3C5 \uD53C\uD574 \uD2F1 \uAC04\uACA9\uC744 \uC808\uBC18\uC73C\uB85C
      \uC904\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531809
    m_Localized: "\uB300\uC0C1\uC758 \uB3C5 \uC2A4\uD0DD \uC218\uB9CC\uD07C \uD22C\uCC99
