    m_Metadata:
      m_Items: []
  - m_Id: 41536819531802
    m_Localized: "\uBD80\uC2DD \uC2DC\uB108\uC9C0\uAC00 \uD65C\uC131\uD654\uB418\uC5B4
      \uC788\uC744 \uB54C \uC544\uAD70\uC774 \uBC1B\uB294 \uCE58\uC720\uB7C9\uC774
