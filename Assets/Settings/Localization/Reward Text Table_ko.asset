  m_TableData:
  - m_Id: 47607881633792
    m_Localized: "\uAE30\uC6D0\uC758 \uCF54\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 47607890022400
    m_Localized: "\uBAA8\uB4E0 \uBCF4\uC11D\uC758 \uD798\uC774 \uC2DC\uC791\uB418\uB294
      \uADFC\uC6D0 \uCF54\uC5B4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607894216704
    m_Localized: "\uB9C8\uBB34\uB9AC \uD22C\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 47607894216705
    m_Localized: "\uCD5C\uB300 \uCC28\uC9C0 \uC2DC\uAC04 \uC81C\uD55C\uC774 5\uCD08\uB85C
      \uACE0\uC815\uB429\uB2C8\uB2E4. \uD480 \uCC28\uC9C0 \uC2DC \uD22C\uCC99 \uD6A8\uACFC\uAC00
      50% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411008
    m_Localized: "\uB178\uB828\uD55C \uD22C\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411009
    m_Localized: "\uCC28\uC9C0 \uC911 \uC774\uB3D9 \uC18D\uB3C4 \uAC10\uC18C\uAC00
      25%\uB85C \uC904\uC5B4\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411010
    m_Localized: "\uB9C8\uAD6C: \uC544\uB9AC\uB791\uBCFC"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411011
    m_Localized: "\uCC28\uC9C0 \uC2DC\uAC04 -0.5\uCD08, \uAC15\uC18D\uAD6C \uD6A8\uACFC
      -40%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411012
    m_Localized: "\uB9C8\uAD6C: \uD30C\uC774\uC5B4\uBCFC"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411013
    m_Localized: "\uD544\uC694 \uCC28\uC9C0 \uC2DC\uAC04 1\uCD08\uB2F9 \uAC15\uC18D\uAD6C
      \uD6A8\uACFC +10%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411014
    m_Localized: "\uC138\uD2B8 \uD3EC\uC9C0\uC158"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411015
    m_Localized: "\uCC28\uC9C0 \uC2DC\uAC04 -0.1\uCD08, \uAC15\uC18D\uAD6C \uD6A8\uACFC
      -2%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411016
    m_Localized: "\uC640\uC778\uB4DC\uC5C5"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411017
    m_Localized: "\uCC28\uC9C0 \uC2DC\uAC04 +0.5\uCD08, \uAC15\uC18D\uAD6C \uD6A8\uACFC
      +2%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411018
    m_Localized: "\uAE30\uBCF8 \uCCB4\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411019
    m_Localized: "\uCD5C\uB300 \uC2A4\uD0DC\uBBF8\uB098 +20."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411020
    m_Localized: "\uC228 \uACE0\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411021
    m_Localized: "\uBE44\uC804\uD22C \uC2DC \uC790\uC5F0 \uC2A4\uD0DC\uBBF8\uB098
      \uD68C\uBCF5\uB7C9\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411022
    m_Localized: "\uD6A8\uC728\uC801\uC778 \uD22C\uCC99"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411023
    m_Localized: "\uCD5C\uB300 \uC2A4\uD0DC\uBBF8\uB098 -40, \uD22C\uCC99 \uD6A8\uACFC
      +60%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411024
    m_Localized: "\uB05D\uC5C6\uB294 \uD65C\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411025
    m_Localized: "\uC790\uC5F0 \uC2A4\uD0DC\uBBF8\uB098 \uD68C\uBCF5\uB7C9\uC774
      \uC99D\uAC00\uD569\uB2C8\uB2E4 (+0.5)."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411026
    m_Localized: "\uC8FD\uC74C\uC758 \uC218\uD655"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411027
    m_Localized: "\uC8FD\uC740 \uBBF8\uB2C8\uC5B8 \uC218\uC5D0 \uBE44\uB840\uD558\uC5EC
      \uC2A4\uD0DC\uBBF8\uB098 \uD68C\uBCF5\uB7C9\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411028
    m_Localized: "\uD55C\uACC4 \uB3CC\uD30C"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411029
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB098\uAC00 0 \uBBF8\uB9CC\uC73C\uB85C \uB5A8\uC5B4\uC9C8
      \uC218 \uC788\uC2B5\uB2C8\uB2E4 (\uCD5C\uB300 -50). \uC74C\uC218\uC77C \uB54C\uB294
      \uD68C\uBCF5\uB7C9\uC774 \uC808\uBC18\uC774 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411030
    m_Localized: "\uC18D\uC0AC\uC758 \uB2EC\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411031
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB098 \uC18C\uBAA8 -7, \uD22C\uCC99 \uD6A8\uACFC
      -30%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411032
    m_Localized: "\uADDC\uCE59\uC801\uC778 \uD638\uD761"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411033
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB098 \uC18C\uBAA8 -3."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411034
    m_Localized: "\uB118\uCE58\uB294 \uD22C\uCC99"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411035
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB098 \uC18C\uBAA8 +5, \uD22C\uCC99 \uD6A8\uACFC
      +25%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411036
    m_Localized: "\uD22C\uCC99 \uACFC\uBD80\uD558"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411037
    m_Localized: "\uC2A4\uD0DC\uBBF8\uB098 \uC18C\uBAA8 1\uB2F9 \uD22C\uCC99 \uD6A8\uACFC
      +2%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411038
    m_Localized: "\uD22C\uCC99 \uBC14\uC6B4\uC2F1 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411039
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uBC14\uC6B4\uC2F1"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411040
    m_Localized: "\uD22C\uCC99 \uC800\uAE00\uB9C1 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411041
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uC800\uAE00\uB9C1"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411042
    m_Localized: "\uD22C\uCC99 \uD658\uC601 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411043
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uD658\uC601"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411044
    m_Localized: "\uD22C\uCC99 \uAD00\uD1B5 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411045
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uAD00\uD1B5"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411046
    m_Localized: "\uD22C\uCC99 \uD540\uBCFC \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411047
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uD540\uBCFC"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411048
    m_Localized: "\uD22C\uCC99 \uBC18\uBCF5 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411049
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uBC18\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411050
    m_Localized: "\uD22C\uCC99 \uD0C0\uC774\uBC0D \uCC28\uC9C0 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411051
    m_Localized: "\uD22C\uCC99 \uB2A5\uB825: \uD0C0\uC774\uBC0D \uCC28\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411052
    m_Localized: "\uBBF8\uB2C8\uC5B8 \uC2A4\uD0EF \uBCF4\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411053
    m_Localized: "\uBAA8\uB4E0 \uBBF8\uB2C8\uC5B8 \uC2A4\uD0EF\uC744 \uAC15\uD654\uD558\uB294
      \uBCF4\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411054
    m_Localized: "\uD22C\uCC99 \uD6A8\uACFC \uBCF4\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411055
    m_Localized: "\uBAA8\uB4E0 \uD22C\uCC99 \uD6A8\uACFC\uB97C \uAC15\uD654\uD558\uB294
      \uBCF4\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123755859968
    m_Localized: "\uAE30\uBCF8 \uAD81\uC218 \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 48123760054272
    m_Localized: "\uAE30\uBCF8 \uC0AC\uC81C \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 48123760054273
    m_Localized: "\uAE30\uBCF8 \uBC29\uD328\uBCD1 \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 48123760054274
    m_Localized: "\uAE30\uBCF8 \uCC3D\uBCD1 \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 48123760054275
    m_Localized: "\uAE30\uBCF8 \uC804\uC0AC \uBBF8\uB2C8\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637184
    m_Localized: "\uD544\uB4DC \uC704\uC758 \uCD1D \uB178\uD654 \uC2A4\uD0DD 100\uB2F9
      \uC544\uAD70\uC758 \uACF5\uACA9 \uC18D\uB3C4\uAC00 10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637185
    m_Localized: "\uB178\uD654 \uC2A4\uD0DD\uC774 50 \uC774\uC0C1\uC778 \uC801\uC758
      \uACF5\uACA9 \uBE57\uB098\uAC10 \uD655\uB960\uC774 25% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637186
    m_Localized: "\uAC00\uC7A5 \uB178\uD654 \uC2A4\uD0DD\uC774 \uB192\uC740 \uC801
      \uC8FC\uBCC0\uC5D0 20% \uB454\uD654 \uBC0F \uB178\uD654 \uC7A5\uD310\uC744
      \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637187
    m_Localized: "\uCD5C\uB300 \uB178\uD654 \uC2A4\uD0DD\uC774 100\uC73C\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uCD5C\uB300 \uC2A4\uD0DD \uB3C4\uB2EC \uC2DC \uB300\uC0C1\uC744 \uC989\uC0AC\uC2DC\uD0B5\uB2C8\uB2E4
      (\uBCF4\uC2A4 \uC81C\uC678)."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637188
    m_Localized: "\uD22C\uCC99 \uBC94\uC704 \uC911\uC2EC\uC5D0 \uC788\uB294 \uC801\uC5D0\uAC8C
      20%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637189
    m_Localized: "\uBC94\uC704 \uB0B4\uC5D0 \uC801\uC911\uD55C \uC801 \uD558\uB098\uB2F9
      \uD22C\uCC99 \uD53C\uD574\uAC00 5% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637190
    m_Localized: "\uACF5\uACA9 \uBE57\uB098\uAC10 \uC2DC \uCCB4\uB825\uC774 50% \uBBF8\uB9CC\uC774\uBA74
      \uACF5\uACA9\uB825\uC774 15% \uC99D\uAC00\uD558\uACE0, 50% \uC774\uC0C1\uC774\uBA74
      \uACF5\uACA9 \uC18D\uB3C4\uAC00 15% \uC99D\uAC00\uD569\uB2C8\uB2E4. (\uBCF4\uC774\uC9C0
      \uC54A\uB294 \uBE57\uB098\uAC10 \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637191
    m_Localized: "\uAD81\uC218\uC758 \uD22C\uCC99 \uBC94\uC704 \uBC18\uACBD\uC774
      20% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637192
    m_Localized: "\uAD81\uC218\uC758 \uAD11\uC5ED \uD22C\uCC99 \uD53C\uD574\uAC00
      15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637193
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 \uC18D\uB3C4\uAC00 25% \uAC10\uC18C\uD558\uC9C0\uB9CC
      \uAE30\uBCF8 \uACF5\uACA9 \uD53C\uD574\uAC00 25% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637194
    m_Localized: "\uD2B8\uB9AC\uAC70\uB85C \uC791\uC6A9\uD569\uB2C8\uB2E4: \uAE30\uBCF8
      \uACF5\uACA9 \uBE57\uB098\uAC10 \uC2DC \uB2E4\uC74C \uBC84\uD504\uAC00 \uC7A5\uC804\uB429\uB2C8\uB2E4.
      (\uC790\uC5F0\uC758 \uD22C\uC601 \uD544\uC694)"
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637195
    m_Localized: "\uBE44\uD589 \uAC70\uB9AC\uC5D0 \uBE44\uB840\uD558\uC5EC \uD22C\uCC99
      \uD53C\uD574\uAC00 1%\uC5D0\uC11C 33%\uAE4C\uC9C0 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637196
    m_Localized: "\uD76C\uC0DD\uC790\uAC00 20%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C
      \uBC1B\uB294 \uC57D\uD654 \uB514\uBC84\uD504\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637197
    m_Localized: "\uD3ED\uBC1C \uC2DC \uD53C\uC758 \uD3ED\uBC1C \uC2A4\uD0DD\uC758
      \uB450 \uBC30\uB9CC\uD07C \uC544\uAD70\uC5D0\uAC8C \uBCF4\uD638\uB9C9\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637198
    m_Localized: "\uD3ED\uBC1C \uD53C\uD574\uC758 1/4\uC744 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C
      \uD53C\uC758 \uD3ED\uBC1C \uC2A4\uD0DD\uC73C\uB85C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637199
    m_Localized: "\uD3ED\uBC1C \uBC18\uACBD \uB0B4\uC758 \uC544\uAD70\uC744 \uD53C\uC758
      \uD3ED\uBC1C \uC2A4\uD0DD \uC218\uB9CC\uD07C \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637200
    m_Localized: "\uD53C\uC758 \uD3ED\uBC1C \uD53C\uD574\uAC00 10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637201
    m_Localized: "\uD3ED\uBC1C \uD6C4 5\uCD08\uAC04 \uC720\uC9C0\uB418\uB294 \uB3C5
      \uC7A5\uD310\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637202
    m_Localized: "\uD3ED\uBC1C \uC804 1.5\uBC30 \uBC18\uACBD \uB0B4\uC758 \uC801\uB4E4\uC744
      \uB04C\uC5B4\uB2F9\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637203
    m_Localized: "\uBE59\uACB0 \uC2DC \uBC18\uACBD \uB0B4\uC5D0 50\uC758 \uD55C\uAE30
      \uC2A4\uD0DD\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4 (\uBC29\uB2F9 1\uD68C)."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637204
    m_Localized: "\uBE59\uACB0 \uC2DC \uD55C\uAE30 \uC2A4\uD0DD\uC774 10\uC5D0\uC11C
      \uC2DC\uC791\uD569\uB2C8\uB2E4. \uBE59\uACB0 \uC911\uC5D0\uB294 \uC2A4\uD0DD\uC774
      \uC313\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637205
    m_Localized: "\uC8FC\uBCC0 \uC801\uB4E4\uC5D0\uAC8C 1\uC758 \uD55C\uAE30 \uC2A4\uD0DD\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637206
    m_Localized: "\uD55C\uAE30\uAC00 \uBB3B\uC740 \uC801\uC5D0\uAC8C 10%\uC758 \uCD94\uAC00
      \uB454\uD654\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637207
    m_Localized: "\uD55C\uAE30\uAC00 \uBB3B\uC740 \uC801\uC5D0\uAC8C 5%\uC758 \uCD94\uAC00
      \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637208
    m_Localized: "\uD22C\uCC99 \uC2DC \uBE59\uACB0\uC744 \uD574\uC81C\uD558\uACE0
      50%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637209
    m_Localized: "\uCD5C\uB300 \uD55C\uAE30 \uC2A4\uD0DD\uACFC \uBE59\uACB0 \uC784\uACC4\uAC12\uC774
      10 \uC99D\uAC00\uD569\uB2C8\uB2E4 (\uCD1D 30)."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637210
    m_Localized: "\uBD80\uC2DD \uC2DC\uB108\uC9C0\uC758 \uD53C\uD574 \uC99D\uD3ED\uB7C9\uC774
      10% \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637211
    m_Localized: "\uBD80\uC2DD \uC2DC\uB108\uC9C0\uAC00 \uD65C\uC131\uD654\uB418\uC5B4
      \uC788\uC744 \uB54C \uC544\uAD70\uC774 \uBC1B\uB294 \uCE58\uC720\uB7C9\uC774
      20% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637212
    m_Localized: "\uBD80\uC2DD\uB41C \uC801\uC5D0\uAC8C\uC11C 5\uBC88 \uD53C\uACA9\uB420
      \uB54C\uB9C8\uB2E4 \uBD80\uC2DD\uB41C \uC801\uC5D0\uAC8C \uCD5C\uB300 \uCCB4\uB825\uC758
      5% \uACE0\uC815 \uD53C\uD574\uB97C \uBC18\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637213
    m_Localized: "\uBD80\uC2DD\uB41C \uC801\uC758 \uACF5\uACA9\uB825\uC774 10% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637214
    m_Localized: "\uB300\uC0C1\uC744 \uCC98\uD615\uD560 \uB54C 1\uCD08 \uB3D9\uC548
      \uC8FC\uBCC0 \uC801\uB4E4\uC5D0\uAC8C \uACF5\uD3EC\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637215
    m_Localized: "\uCC98\uD615 \uC784\uACC4\uAC12\uC774 10% \uC644\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637216
    m_Localized: "\uB3C5 \uD53C\uD574 \uD2F1\uB9C8\uB2E4 \uD3EC\uC158\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637217
    m_Localized: "\uB3C5 \uD53C\uD574 \uD2F1 \uAC04\uACA9\uC744 \uC808\uBC18\uC73C\uB85C
      \uC904\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637218
    m_Localized: "\uB300\uC0C1\uC758 \uB3C5 \uC2A4\uD0DD \uC218\uB9CC\uD07C \uD22C\uCC99
      \uD53C\uD574\uB97C \uCD94\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637219
    m_Localized: "\uC0AC\uB9DD \uC2DC \uC8FC\uBCC0 \uC801\uB4E4\uC5D0\uAC8C \uB3C5\uC744
      \uC804\uC5FC\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637220
    m_Localized: "\uAE30\uBCF8 \uD22C\uCC99 \uB3C5 \uC2A4\uD0DD \uBD80\uC5EC\uB7C9\uC774
      1 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637221
    m_Localized: "\uB3C5 \uBC1C\uC790\uAD6D \uC7A5\uD310\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4.
      \uC544\uAD70\uC758 \uC774\uB3D9 \uC18D\uB3C4\uAC00 15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637222
    m_Localized: "3\uCD08\uB9C8\uB2E4 \uC8FC\uBCC0 \uBC18\uACBD\uC5D0 \uB3C5 \uC2A4\uD0DD\uC744
      \uD37C\uB728\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637223
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 \uC2DC \uB3C5 \uD53C\uD574 \uD2F1 \uAC04\uACA9\uC774
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637224
    m_Localized: "5\uCD08\uB9C8\uB2E4 \uBC29\uD328\uBCD1 \uCD5C\uB300 \uCCB4\uB825\uC758
      4%\uB9CC\uD07C \uC8FC\uBCC0 \uC801\uB4E4\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0
      \uAC00\uD55C \uD53C\uD574\uC758 120%\uB9CC\uD07C \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637225
    m_Localized: "5\uCD08\uB9C8\uB2E4 \uC544\uAD70\uC5D0\uAC8C \uBC29\uD328\uBCD1
      \uCD5C\uB300 \uCCB4\uB825\uC758 18%\uC5D0 \uD574\uB2F9\uD558\uB294 \uBCF4\uD638\uB9C9\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637226
    m_Localized: "\uB2E8\uC77C \uD22C\uCC99 \uC801\uC911 \uC2DC \uBCF4\uD638\uB9C9
      \uC218\uCE58\uC758 14%\uC5D0 \uD574\uB2F9\uD558\uB294 \uBB3C\uB9AC \uD53C\uD574\uB97C
      \uCD94\uAC00\uB85C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637227
    m_Localized: "\uBC29\uD328\uBCD1\uC758 \uBAA8\uB4E0 \uC2A4\uD0EF\uC774 10% \uC99D\uAC00\uD569\uB2C8\uB2E4.\\n\uBC29\uC5D0
      \uC9C4\uC785 \uC2DC 10\uCD08 \uB3D9\uC548 \uC544\uAD70\uC758 \uACF5\uACA9\uB825\uC774
      8% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637228
    m_Localized: "\uBC29\uD328\uBCD1\uC758 \uBAA8\uB4E0 \uC2A4\uD0EF\uC774 10% \uC99D\uAC00\uD569\uB2C8\uB2E4.\\n\uBC29\uC5D0
      \uC9C4\uC785 \uC2DC 10\uCD08 \uB3D9\uC548 \uC544\uAD70\uC758 \uACF5\uACA9 \uC18D\uB3C4\uAC00
      12% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637229
    m_Localized: "\uBC29\uD328\uBCD1\uC758 \uBAA8\uB4E0 \uC2A4\uD0EF\uC774 10% \uC99D\uAC00\uD569\uB2C8\uB2E4.\\n\uBC29\uC5D0
      \uC9C4\uC785 \uC2DC 10\uCD08 \uB3D9\uC548 \uC544\uAD70\uC758 \uC774\uB3D9 \uC18D\uB3C4\uAC00
      14% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637230
    m_Localized: "\uBC29\uC5D0 \uC9C4\uC785 \uC2DC \uBC29\uD328\uBCD1\uC5D0\uAC8C
      \uCD5C\uB300 \uCCB4\uB825\uC758 50%\uC5D0 \uD574\uB2F9\uD558\uB294 \uBCF4\uD638\uB9C9\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637231
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9\uC744 \uBC1B\uC744 \uB54C \uACF5\uACA9\uC790
      \uD604\uC7AC \uCCB4\uB825\uC758 2%\uC5D0 \uD574\uB2F9\uD558\uB294 \uACE0\uC815
      \uD53C\uD574\uB97C \uBC18\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637232
    m_Localized: "\uB2E8\uC77C \uD22C\uCC99 \uC801\uC911 \uC2DC \uBCF4\uD638\uB9C9
      \uC218\uCE58\uC758 20%\uC5D0 \uD574\uB2F9\uD558\uB294 \uAD11\uC5ED \uD53C\uD574\uB97C
      \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637233
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 \uC2DC \uC801\uC744 \uB109\uBC31\uC2DC\uD0B5\uB2C8\uB2E4.
      \uC801\uC774 \uBCBD\uC5D0 \uBD80\uB52A\uD788\uBA74 \uCD5C\uB300 \uCCB4\uB825\uC758
      12%\uB97C \uD53C\uD574\uB85C \uC785\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637234
    m_Localized: "\uD22C\uCC99 \uCC29\uD0C4 \uC2DC\uAC04\uC744 33% \uB2E8\uCD95\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637235
    m_Localized: "\uCC3D\uBCD1\uC758 \uAE30\uBCF8 \uACF5\uACA9 \uD53C\uD574\uAC00
