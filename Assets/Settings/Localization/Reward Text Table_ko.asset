    m_Metadata:
      m_Items: []
  - m_Id: 48123772637250
    m_Localized: "\uCD5C\uB300 \uC2A4\uD0DC\uBBF8\uB098\uAC00 20 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637251
    m_Localized: "\uBE44\uC804\uD22C \uC2DC \uC790\uC5F0 \uC2A4\uD0DC\uBBF8\uB098
