      8% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531819
    m_Localized: "\uBC29\uD328\uBCD1\uC758 \uBAA8\uB4E0 \uC2A4\uD0EF\uC774 10% \uC99D\uAC00\uD569\uB2C8\uB2E4.\\n\uBC29\uC5D0
      \uC9C4\uC785 \uC2DC 10\uCD08 \uB3D9\uC548 \uC544\uAD70\uC758 \uACF5\uACA9 \uC18D\uB3C4\uAC00
      12% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531820
    m_Localized: "\uBC29\uD328\uBCD1\uC758 \uBAA8\uB4E0 \uC2A4\uD0EF\uC774 10% \uC99D\uAC00\uD569\uB2C8\uB2E4.\\n\uBC29\uC5D0
      \uC9C4\uC785 \uC2DC 10\uCD08 \uB3D9\uC548 \uC544\uAD70\uC758 \uC774\uB3D9 \uC18D\uB3C4\uAC00
      14% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531821
    m_Localized: "\uBC29\uC5D0 \uC9C4\uC785 \uC2DC \uBC29\uD328\uBCD1\uC5D0\uAC8C
      \uCD5C\uB300 \uCCB4\uB825\uC758 50%\uC5D0 \uD574\uB2F9\uD558\uB294 \uBCF4\uD638\uB9C9\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41536819531822
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9\uC744 \uBC1B\uC744 \uB54C \uACF5\uACA9\uC790
