    m_Metadata:
      m_Items: []
  - m_Id: 48123772637238
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9\uC5D0 3%\uC758 \uC0DD\uBA85\uB825 \uD761\uC218\uB97C
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637239
    m_Localized: "\uAC19\uC740 \uB300\uC0C1\uC744 \uD22C\uCC99\uC73C\uB85C \uBC18\uBCF5\uD574\uC11C
      \uB9DE\uCD9C \uB54C 12%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637240
    m_Localized: "\uC804\uC0AC\uC758 \uD3EC\uBB3C\uC120 \uD22C\uCC99 \uD53C\uD574\uAC00
      10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48123772637241
    m_Localized: "\uC804\uC0AC\uC758 \uC9C1\uC0AC \uD22C\uCC99 \uD53C\uD574\uAC00
