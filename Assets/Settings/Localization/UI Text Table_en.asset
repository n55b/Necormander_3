  - m_Id: 4625352133414912
    m_Localized: "\uBC14\uB2E5 \uBD80\uC218\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940864
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uAC00 \uBC14\uB2E5\uC744 \uB0B4\uB9AC\uCCD0,
      2\uCE78 \uC8FC\uBCC0\uC758 \uC801\uC744 \uB04C\uC5B4\uB2F9\uAE30\uACE0 \uCDE8\uC57D
      1\uC2A4\uD0DD\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940865
    m_Localized: "\uCCA0\uC0B0\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940866
    m_Localized: "\uC804\uBC29\uC73C\uB85C \uB3CC\uC9C4\uD558\uBA70 \uC801\uC744
      \uBC00\uCCD0\uB0B4\uACE0 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940867
    m_Localized: "\uAC00\uB4DC \uBD80\uC218\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940868
    m_Localized: "\uAC15\uB825\uD55C \uC815\uAD8C \uC9C0\uB974\uAE30\uB85C \uC801\uC744
      \uBC00\uCCD0\uB0B4\uBA70 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940869
    m_Localized: "\uB465\uB465\uD0C0"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940870
    m_Localized: "\uBE60\uB974\uAC8C 3\uC5F0\uD0C0 \uACF5\uACA9\uC744 \uB0A0\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940871
    m_Localized: "\uAF41!"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940872
    m_Localized: "\uAE30\uC808 \uC0C1\uD0DC\uC778 \uC801\uC744 \uD0C0\uACA9\uD558\uC5EC
      \uAE30\uC808\uC744 \uC18C\uBAA8\uD558\uACE0 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940873
    m_Localized: "\uCD1D\uB09C\uD0C0"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940874
    m_Localized: "\uACA9\uD30C \uC0C1\uD0DC\uC778 \uC801\uC744 \uD0C0\uACA9\uD558\uC5EC
      \uACA9\uD30C\uB97C \uC18C\uBAA8\uD558\uACE0 6\uC5F0\uD0C0 \uD53C\uD574\uB97C
      \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940875
    m_Localized: "\uC721\uC655\uAD8C"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940876
    m_Localized: "\uAC15\uD0C0 \uC0C1\uD0DC\uC778 \uC801\uC744 \uD0C0\uACA9\uD558\uC5EC
      \uAC15\uD0C0\uB97C \uC18C\uBAA8\uD558\uACE0 \uCE58\uBA85\uC801\uC778 \uC77C\uACA9\uC744
      \uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940877
    m_Localized: "\uC5F0\uACC4 1"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940878
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC21C\uAC04\uC774\uB3D9\uD558\uC5EC \uAE30\uBCF8
      \uACF5\uACA9\uB825\uC758 200% \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940879
    m_Localized: "\uC5F0\uACC4 2.1"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940880
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC21C\uAC04\uC774\uB3D9\uD558\uC5EC \uC801\uC744
      \uB109\uBC31\uC2DC\uD0A4\uACE0 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940881
    m_Localized: "\uC5F0\uACC4 2.2"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940882
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC21C\uAC04\uC774\uB3D9\uD558\uC5EC \uC801\uC744
      \uB04C\uC5B4\uB2F9\uAE30\uACE0 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352187940883
    m_Localized: "\uC5F0\uACC4 4.1"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352192135168
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC21C\uAC04\uC774\uB3D9\uD558\uC5EC \uD0C0\uACA9\uD558\uACE0,
      \uCDE8\uC57D \uC2A4\uD0DD\uC774 3\uC2A4\uD0DD \uC774\uC0C1\uC774\uBA74 \uAE30\uC808\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352192135169
    m_Localized: "\uC5F0\uACC4 4.2"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352192135170
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC21C\uAC04\uC774\uB3D9\uD558\uC5EC \uD0C0\uACA9\uD558\uACE0,
      \uCDE8\uC57D \uC2A4\uD0DD\uC774 3\uC2A4\uD0DD \uC774\uC0C1\uC774\uBA74 \uACA9\uD30C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352192135171
    m_Localized: "\uC5F0\uACC4 4.3"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352192135172
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC21C\uAC04\uC774\uB3D9\uD558\uC5EC \uD0C0\uACA9\uD558\uACE0,
      \uCDE8\uC57D \uC2A4\uD0DD\uC774 3\uC2A4\uD0DD \uC774\uC0C1\uC774\uBA74 \uAC15\uD0C0\uB97C
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4625352192135173
    m_Localized: "\uC5F0\uACC4 5"
    m_Metadata:
      m_Items: []
  - m_Id: 4625352192135174
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC21C\uAC04\uC774\uB3D9\uD558\uC5EC \uD0C0\uACA9\uD558\uACE0,
      \uB300\uC0C1\uC774 \uAE30\uC808 \uC0C1\uD0DC\uC774\uBA74 \uAE30\uC808 \uC2DC\uAC04\uC744
      \uC5F0\uC7A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
