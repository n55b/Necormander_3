  - m_Id: 47607898411216
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 3\uC5F0\uD0C0 (1 / 1 / 1.5). \uBCF4\uD1B5
      \uACF5\uACA9 \uC18D\uB3C4 \xB7 \uACBD\uC9C1 0.2\uCD08.\n\uACF5\uACA9\uB825
      +10.\n\uACF5\uACA9 \uC18D\uB3C4 +20%.\n\uB9C8\uB9AC\uC624\uB124\uD2B8: \uD50C\uB808\uC774\uC5B4\xB7\uC18C\uD658\uC218
      \uD3C9\uD0C0\uC758 \uD0C0\uC218 2\uBC30, \uAC01 \uD0C0\uACA9 \uD53C\uD574 60%.
      \uBAA8\uC158\uC740 \uC720\uC9C0. \uC18C\uD658\uC218 \uB300\uC26C \uACF5\uACA9
      \uD53C\uD574 +30%."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411217
    m_Localized: "\uB9C8\uB9AC\uC624\uB124\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411218
    m_Localized: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uB3CC\uC9C4,
      \uC8FC\uBCC0 \uC801\uC744 5\uD68C \uACF5\uACA9"
