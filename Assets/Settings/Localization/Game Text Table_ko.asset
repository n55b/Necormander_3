      m_Items: []
  - m_Id: 47607898411219
    m_Localized: "\uD68C\uC804 \uB09C\uD0C0"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411220
    m_Localized: "\uC870\uC900 \uBC29\uD5A5\uC73C\uB85C 3\uC5F0\uC18D \uCDA9\uACA9\uD30C.
      \uC801\uC911\uD55C \uC801\uC5D0\uAC8C \uCDE8\uC57D(\uBC1B\uB294 \uBB3C\uB9AC
      \uD53C\uD574 \uC99D\uAC00)"
