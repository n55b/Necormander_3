      m_Items: []
  - m_Id: 47607898411273
    m_Localized: "\uB354 \uC774\uC0C1 \uBC1B\uC744 \uC218 \uC788\uB294 \uC7A5\uBE44\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411274
    m_Localized: "\uB354 \uC774\uC0C1 \uBC1B\uC744 \uC218 \uC788\uB294 \uC18C\uD658\uC218\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411275
    m_Localized: "\uB354 \uC774\uC0C1 \uBC1B\uC744 \uC218 \uC788\uB294 \uBCF4\uC0C1\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411276
    m_Localized: "\uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411277
    m_Localized: "\uBD88\uB7EC\uC624\uB294 \uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411278
    m_Localized: "\uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uAC8C\uC784\uC744
      \uB2E4\uC2DC \uC2DC\uC791\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 47607898411279
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 3\uC5F0\uD0C0 (1 / 1 / 1.5). \uBCF4\uD1B5
      \uACF5\uACA9 \uC18D\uB3C4 \xB7 \uACBD\uC9C1 0.2\uCD08.\n\uACF5\uACA9\uB825
      +15.\n\uC18C\uD658\uC218 \uC6B0\uD074\uB9AD \uC2A4\uD0AC \uCFE8\uD0C0\uC784
      -20%.\n\uD589\uC6B4: \uD3C9\uD0C0 \uCCAB \uC801\uC911\uB9C8\uB2E4 13% + Luck
      \uD655\uB960\uB85C \uC18C\uD658\uC218 \uC2A4\uD0AC \uCFE8\uD0C0\uC784 \uCD08\uAE30\uD654.
